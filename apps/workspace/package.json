{
  "name": "aicl-workspace",
  "private": true,
  "type": "module",
  "bin": {
    "aicl": "bin/aicl.mjs"
  },
  "description": "Generative canvas workspace: a Pi agent and a person share a scratchpad beside the chat.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --experimental-strip-types --no-warnings server/main.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test server/*.test.ts",
    "e2e": "node e2e/canvas.mjs"
  },
  "dependencies": {
    "@aicl/core": "file:../../packages/core",
    "@aicl/react": "file:../../packages/react",
    "@aicl/server": "file:../../packages/server",
    "@aicl/styles": "file:../../packages/styles",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^5.5.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.2.0",
    "playwright-core": "1.58.2"
  }
}
