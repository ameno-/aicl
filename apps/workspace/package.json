{
  "name": "aicl-workspace",
  "private": true,
  "type": "module",
  "bin": {
    "aicl": "bin/aicl.mjs"
  },
  "description": "Generative canvas workspace: a Pi agent and a person share a scratchpad beside the chat.",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "node --experimental-strip-types --no-warnings server/main.ts",
    "web": "vite",
    "start": "node --experimental-strip-types --no-warnings server/main.ts --serve-web",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test server/*.test.ts",
    "e2e": "node e2e/canvas.mjs",
    "e2e:app": "node e2e/app.mjs"
  },
  "dependencies": {
    "@aicl/core": "file:../../packages/core",
    "@aicl/fx": "file:../../packages/fx",
    "@aicl/react": "file:../../packages/react",
    "@aicl/server": "file:../../packages/server",
    "@aicl/styles": "file:../../packages/styles",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/rbush": "^4.0.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "node-pty": "^1.1.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^5.5.2",
    "typebox": "1.3.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "playwright-core": "1.58.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.2.0"
  }
}
