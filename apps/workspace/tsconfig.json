{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@aicl/core": ["../../packages/core/src/index.ts"],
      "@aicl/react": ["../../packages/react/src/index.ts"],
      "@aicl/react/markdown": ["../../packages/react/src/markdown.tsx"],
      "@aicl/server": ["../../packages/server/src/index.ts"],
      "@aicl/fx": ["../../packages/fx/src/index.ts"]
    }
  },
  "include": ["server", "shared", "web", "vite.config.ts"]
}
