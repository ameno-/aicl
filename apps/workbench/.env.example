# Copy to .env: cp .env.example .env
# Compose reads .env automatically; npm run smoke reads it via --env-file-if-exists.

# Shared admin/worker auth token.
# Secret — set in shell env / 1Password, never commit.
RIVET_TOKEN=

# Endpoint used by scripts/smoke.ts on the host (worker uses the in-network
# http://rivet-engine:6420 set in compose.yaml).
RIVET_ENDPOINT=http://localhost:6420

# Heartbeat cron for the nasir agent (non-secret; default every 30 minutes).
NASIR_HEARTBEAT_CRON=*/30 * * * *
