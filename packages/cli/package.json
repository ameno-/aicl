{
  "name": "@aicl/cli",
  "version": "0.0.0",
  "description": "Discover, document, and install AICL components. npx aicl list | add | docs | doctor.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aicl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "registry": "node scripts/build-registry.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
